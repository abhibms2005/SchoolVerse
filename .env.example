# SchoolVerse environment variables — copy to .env (or set in the host's
# dashboard) and fill in real values. NEVER commit real secrets.

# --- Server ---
# HTTP port the app listens on.
PORT=3000
# Where the SQLite database file lives (Render free tier: ./data/schoolverse.db;
# paid + disk: /var/data/schoolverse.db).
DB_PATH=db/schoolverse.db
# Where uploaded form files are stored (Render free tier: ./data/uploads).
UPLOADS_DIR=public/uploads
# HMAC secret for signed session cookies — set a long random string in production.
# render.yaml generates one automatically for the Render deploy.
SESSION_SECRET=change-me-to-a-long-random-string
# Admin account for seeding / boot provisioning. REQUIRED whenever seeding runs
# (npm run db:seed / setup, or SEED_DEMO_ON_BOOT=true) — there is no default.
SEED_ADMIN_EMAIL=admin@your-school.org
SEED_ADMIN_PASSWORD=change-me
# "true" → seed demo data on boot ONLY when the database is empty (ephemeral
# hosting like Render's free tier re-seeds after each wipe).
SEED_DEMO_ON_BOOT=true

# --- AI document extraction (Google Gemini) ---
# Required for real OCR extraction. Without it, uploads still work but land in
# the review queue as "failed" for manual entry — never a crash. Get a free
# key at https://aistudio.google.com/apikey (format: AIza...).
GEMINI_API_KEY=AIza-your-key-here
# Model used for document extraction. Defaults to gemini-3.6-flash (current
# stable Flash — older models like gemini-2.5-flash are restricted for new
# accounts).
GEMINI_MODEL=gemini-3.6-flash

# --- Simulated scanner script (npm run scan:simulate) ---
# Where the running app is (the script logs in, then posts scans).
BASE_URL=http://localhost:3000
# Milliseconds between simulated scan events.
SCAN_INTERVAL_MS=4000
# Optional: force every simulated scan to one method (rfid | cv | manual).
# Unset = weighted rotation; set to rfid for an all-RFID demo.
SCAN_METHOD=
