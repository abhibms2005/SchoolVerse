{
  "name": "schoolverse",
  "version": "1.0.0",
  "description": "SchoolVerse — AI-powered school operations platform (Express + SQLite + vanilla frontend)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "db:migrate": "node db/migrate.js",
    "db:seed": "node db/seeds/dev-seed.js",
    "setup": "npm run db:migrate && npm run db:seed",
    "test": "node --test \"tests/**/*.test.js\""
  },
  "engines": {
    "node": "22.x"
  },
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.7.0",
    "express": "^4.21.2",
    "multer": "^1.4.5-lts.1"
  }
}
